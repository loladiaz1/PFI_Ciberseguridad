generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Incident {
  id              Int       @id @default(autoincrement())
  source          String
  ruleId          String
  severity        Int
  ruleDescription String?
  srcIp           String?
  hostname        String
  agentId         String
  timestamp       String
  status          String    @default("new")
  blockedAt       DateTime?
  isolatedAt      DateTime?
  // Metricas de tiempo de respuesta (RNF-05, ver src/metrics.js). Sin
  // default a proposito: los incidentes anteriores a la medicion quedan en
  // null y no contaminan las metricas con la fecha de la migracion.
  ingestedAt      DateTime?
  actionLatencyMs Int?
  enrichmentVt        String?
  enrichmentAbuseIpdb String?

  @@map("incidents")
}

model User {
  id       Int    @id @default(autoincrement())
  username String @unique
  name     String
  email    String
  role     String @default("soc-analyst")

  @@map("users")
}

model AuditEvent {
  id        Int      @id @default(autoincrement())
  type      String
  detail    String
  createdAt DateTime @default(now())

  @@map("audit_events")
}
