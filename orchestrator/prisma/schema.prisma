generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Incident {
  id              Int       @id @default(autoincrement())
  source          String
  ruleId          String
  severity        Int
  ruleDescription String?
  srcIp           String
  hostname        String
  agentId         String
  timestamp       String
  status          String    @default("new")
  blockedAt       DateTime?

  @@map("incidents")
}
