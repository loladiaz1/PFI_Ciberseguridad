generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Incident {
  id              Int       @id @default(autoincrement())
  source          String
  ruleId          String
  severity        Int
  ruleDescription String?
  srcIp           String?
  hostname        String
  agentId         String
  timestamp       String
  status          String    @default("new")
  blockedAt       DateTime?
  isolatedAt      DateTime?
  // Metricas de tiempo de respuesta (RNF-05, ver src/metrics.js). Sin
  // default a proposito: los incidentes anteriores a la medicion quedan en
  // null y no contaminan las metricas con la fecha de la migracion.
  ingestedAt      DateTime?
  actionLatencyMs Int?
  // Agrupamiento (src/grouping.js): alertas del mismo ataque se suman a un
  // incidente abierto en vez de crear uno nuevo. ruleIds = JSON con todas
  // las reglas que dispararon; null en incidentes previos (= solo ruleId).
  alertCount      Int       @default(1)
  ruleIds         String?
  lastSeenAt      DateTime?
  enrichmentVt        String?
  enrichmentAbuseIpdb String?

  @@map("incidents")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  name         String
  email        String
  // Roles (src/auth.js): admin | analyst | auditor. "soc-analyst" es el
  // valor anterior al RBAC y se normaliza a "analyst" al arrancar.
  role         String   @default("analyst")
  // pending (registrado, espera aprobacion de un admin) | active | disabled
  status       String   @default("pending")
  // bcrypt; null solo en filas anteriores a los usuarios reales.
  passwordHash String?
  createdAt    DateTime @default(now())

  @@map("users")
}

model AuditEvent {
  id        Int      @id @default(autoincrement())
  type      String
  detail    String
  // Quien ejecuto la accion (username), separado del texto para poder
  // anonimizarlo al eliminar la cuenta sin perder el evento (Ley 25.326,
  // ver src/privacy.js). null = evento del sistema (ej. incidente detectado).
  actor     String?
  createdAt DateTime @default(now())

  @@map("audit_events")
}
