generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Incident {
  id              Int       @id @default(autoincrement())
  source          String
  ruleId          String
  severity        Int
  ruleDescription String?
  srcIp           String?
  hostname        String
  agentId         String
  timestamp       String
  status          String    @default("new")
  blockedAt       DateTime?
  isolatedAt      DateTime?
  // Metricas de tiempo de respuesta (RNF-05, ver src/metrics.js). Sin
  // default a proposito: los incidentes anteriores a la medicion quedan en
  // null y no contaminan las metricas con la fecha de la migracion.
  ingestedAt      DateTime?
  actionLatencyMs Int?
  // Agrupamiento (src/grouping.js): alertas del mismo ataque se suman a un
  // incidente abierto en vez de crear uno nuevo. ruleIds = JSON con todas
  // las reglas que dispararon; null en incidentes previos (= solo ruleId).
  alertCount      Int       @default(1)
  ruleIds         String?
  lastSeenAt      DateTime?
  // Motores de VirusTotal que detectan el archivo (CU-02), de la alerta.
  hashPositives   Int?
  // Automatizacion (src/automation.js): none | simulated | executed | failed,
  // la politica que aplico y el motivo (tambien cuando no aplico ninguna).
  automationDecision String?
  automationPolicy   String?
  automationReason   String?
  enrichmentVt        String?
  enrichmentAbuseIpdb String?
  alerts              IncidentAlert[]

  @@map("incidents")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  name         String
  email        String
  // Roles (src/auth.js): admin | analyst | auditor. "soc-analyst" es el
  // valor anterior al RBAC y se normaliza a "analyst" al arrancar.
  role         String   @default("analyst")
  // pending (registrado, espera aprobacion de un admin) | active | disabled
  status       String   @default("pending")
  // bcrypt; null solo en filas anteriores a los usuarios reales.
  passwordHash String?
  createdAt    DateTime @default(now())

  @@map("users")
}

model AuditEvent {
  id        Int      @id @default(autoincrement())
  type      String
  detail    String
  // Quien ejecuto la accion (username), separado del texto para poder
  // anonimizarlo al eliminar la cuenta sin perder el evento (Ley 25.326,
  // ver src/privacy.js). null = evento del sistema (ej. incidente detectado).
  actor     String?
  // Incidente al que pertenece el evento (null = no es de un incidente, ej.
  // un login). La categoria se deriva del tipo: src/audit.js.
  incidentId Int?
  createdAt DateTime @default(now())

  @@index([incidentId])
  @@map("audit_events")
}

// --- Automatizacion de la respuesta (src/automation.js) -------------------
// Valores iniciales en config/automation.defaults.json; despues los edita un
// admin desde la app.

model AutomationSettings {
  id                 Int      @id @default(1)
  mode               String   @default("simulate") // off | simulate | active
  allowlist          String   @default("[]") // JSON: IPs / CIDR que nunca se bloquean
  defaultCriticality String   @default("medium") // para agentes fuera del inventario
  updatedAt          DateTime @updatedAt
  updatedBy          String?

  @@map("automation_settings")
}

model AutomationPolicy {
  id         Int      @id @default(autoincrement())
  key        String   @unique
  name       String
  order      Int
  enabled    Boolean  @default(false)
  useCase    String // CU-01 | CU-02
  action     String // block-ip | isolate-host
  conditions String // JSON, ver failedConditions() en src/automation.js
  updatedAt  DateTime @updatedAt

  @@map("automation_policies")
}

// Inventario de activos: criticidad de cada agente de Wazuh.
model Asset {
  agentId     String @id
  name        String
  criticality String @default("medium") // low | medium | high | critical

  @@map("assets")
}

// Cada alerta de Wazuh que forma parte de un incidente (la primera y las que
// se agruparon despues): la evidencia del caso. Solo los campos utiles, no la
// alerta cruda (minimizacion de datos, Ley 25.326 art. 4).
model IncidentAlert {
  id              Int      @id @default(autoincrement())
  incident        Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  incidentId      Int
  ruleId          String
  ruleDescription String?
  severity        Int
  timestamp       String // de Wazuh, igual que Incident.timestamp
  receivedAt      DateTime @default(now())
  srcIp           String?
  // Lo que distingue a esta alerta: archivo (CU-02) o usuario intentado (CU-01).
  detail          String?
  hashPositives   Int?

  @@index([incidentId])
  @@map("incident_alerts")
}
