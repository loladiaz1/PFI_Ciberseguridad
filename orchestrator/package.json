{
  "name": "micro-soar-orchestrator",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "pretest": "prisma generate || node -e \"console.warn('prisma generate omitido: el cliente esta en uso (servidor local corriendo?); se usa el ya generado')\"",
    "test": "jest --runInBand",
    "block-ip": "node block_ip.js",
    "test:coverage": "npm test -- --coverage"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.7.0",
    "imapflow": "2.2.1",
    "jsonwebtoken": "^9.0.3",
    "mailparser": "3.9.33",
    "prisma": "^5.22.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "allowScripts": {
    "prisma@5.22.0": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true
  },
  "jest": {
    "setupFiles": [
      "<rootDir>/tests/jest.setup.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageReporters": [
      "text",
      "html",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 85,
        "branches": 85,
        "functions": 85,
        "lines": 85
      }
    },
    "globalSetup": "<rootDir>/tests/globalSetup.js"
  }
}
