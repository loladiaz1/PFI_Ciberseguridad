# URL base de la API de Wazuh (puerto 55000 por defecto)
WAZUH_HOST=https://<ip-del-manager>:55000
WAZUH_USER=wazuh-wui
WAZUH_PASSWORD=changeme

# Dev local: SQLite. Cuando exista la instancia RDS, cambiar solo esta URL
# (ej. postgresql://user:pass@host:5432/soar) — SQLAlchemy no requiere más cambios.
DATABASE_URL=sqlite:///./soar.db
