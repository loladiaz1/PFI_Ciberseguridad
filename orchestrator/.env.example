# URL base de la API de Wazuh (puerto 55000 por defecto)
WAZUH_HOST=https://<ip-del-manager>:55000
WAZUH_USER=wazuh-wui
WAZUH_PASSWORD=changeme

# ID de un agente real registrado (NO 000: ese es el manager y Wazuh rechaza
# active-response ahí). Sacarlo con GET /agents?select=id,name
WAZUH_AGENT_ID=001

# Dev local: SQLite. Cuando exista la instancia RDS, cambiar el provider a
# "postgresql" en prisma/schema.prisma y esta URL (ej. postgresql://user:pass@host:5432/soar).
DATABASE_URL="file:./soar.db"

# Login del analista (MVP: un solo usuario/rol) + firma de JWT
AUTH_USER=analyst
AUTH_PASSWORD=changeme
JWT_SECRET=change-this-to-a-long-random-string

# Enriquecimiento de la IP atacante (opcional). Sin ninguna de las dos, el
# incidente se persiste igual, solo sin enrichmentVt/enrichmentAbuseIpdb.
VT_API_KEY=
ABUSEIPDB_API_KEY=

# CU-03 (phishing): servidor de correo de laboratorio (terraform/mail.tf).
# Sin MAIL_IMAP_HOST la integracion queda apagada. Valores:
#   MAIL_IMAP_HOST       = terraform output mail_private_ip
#   MAIL_MASTER_PASSWORD = terraform output -raw mail_master_password
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_MASTER_USER=soar
MAIL_MASTER_PASSWORD=
MAIL_REPORT_MAILBOX=phishing@lab.micro-soar.internal
# Buzones donde se busca el correo para ponerlo en cuarentena (coma)
MAIL_MAILBOXES=alice@lab.micro-soar.internal,bob@lab.micro-soar.internal
# Activo afectado en el incidente (inventario): nombre y ID del agente de Wazuh del mail server
MAIL_HOSTNAME=micro-soar-mail
MAIL_AGENT_ID=mail
