# URL base de la API de Wazuh (puerto 55000 por defecto)
WAZUH_HOST=https://<ip-del-manager>:55000
WAZUH_USER=wazuh-wui
WAZUH_PASSWORD=changeme

# ID de un agente real registrado (NO 000: ese es el manager y Wazuh rechaza
# active-response ahí). Sacarlo con GET /agents?select=id,name
WAZUH_AGENT_ID=001

# Dev local: SQLite. Cuando exista la instancia RDS, cambiar el provider a
# "postgresql" en prisma/schema.prisma y esta URL (ej. postgresql://user:pass@host:5432/soar).
DATABASE_URL="file:./soar.db"
