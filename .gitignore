# Terraform state (can contain secrets)
*.tfstate
*.tfstate.*
.terraform/
# .terraform.lock.hcl SI se commitea: fija la version del provider para que
# el runner de GitHub use la misma que la laptop.

# Your real variables (holds your public IP)
terraform.tfvars
*.auto.tfvars

# Crash logs
crash.log

# Credenciales locales
.env

# Node
node_modules/
*.db

# Documentacion tecnica interna (solo local, no para el repo remoto)
ARQUITECTURA_TECNICA.md

# Reportes de cobertura de Jest (se regeneran con npm run test:coverage)
coverage/

# ML (ml/): dataset GUIDE (varios GB, se baja de Kaggle), salidas y venv
data/guide/
ml/data/
ml/out/
ml/.venv/
__pycache__/
.pytest_cache/

# Anexo de pruebas: el HTML es intermedio, se versiona el PDF
docs/anexo-pruebas/anexo-pruebas.html

CORRECCIONES para 75%.md