generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("OPERATOR")
  avatarUrl String?
  createdAt DateTime @default(now())

  @@map("users")
}

model Incident {
  id        Int       @id @default(autoincrement())
  source    String
  ruleId    String
  severity  Int
  srcIp     String
  hostname  String
  agentId   String
  timestamp String
  status    String    @default("new")
  blockedAt DateTime?

  @@map("incidents")
}